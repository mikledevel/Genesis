# Copy this file to .env and fill in your real key. Never commit the real .env file.

# Groq API key - get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional automatic fallback provider: if set, ANY outbound LLM call that fails on Groq for
# any reason (bad key, rate limit, timeout, capacity, outage) is automatically retried once via
# OpenRouter before the failure reaches the user - see app/core/groq_client.py:call_llm and
# app/config.py's openrouter_api_key docstring. Get a key at https://openrouter.ai/keys.
# Leave empty to disable (Groq-only, current default behavior).
OPENROUTER_API_KEY=

# Reserved for future use - not currently read anywhere in the codebase (no DeepSeek call
# path exists yet). Leave empty; setting it does nothing today.
DEEPSEEK_API_KEY=

DATABASE_URL=
REDIS_URL=
SECRET_KEY=change-me

# Comma-separated list of your real frontend domain(s) in production, e.g.:
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# Required when DEBUG=false - the app will refuse to start without it (see app/main.py).
ALLOWED_ORIGINS=

# Outbound email for password reset / email verification. Leave blank for local dev - emails
# will just print to the server log instead of actually sending (see app/core/email_sender.py).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Genesis AI <no-reply@your-domain.com>

# Error monitoring - optional. Get a DSN at https://sentry.io. Leave blank to disable.
SENTRY_DSN=

# Stripe - optional, only needed if you want real marketplace top-ups. Get keys at
# https://dashboard.stripe.com/apikeys and https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public HTTPS URL this server is reachable at in production (used for Telegram webhooks and
# for building links in verification/reset emails). Leave blank for local dev.
PUBLIC_BASE_URL=

# Geo-blocking. See app/core/geo_block.py for the full detection logic (Cloudflare header
# first, external API fallback second, fails open if country/region can't be determined) and
# its important limitation notes on region-level accuracy.
# GEOBLOCK_COUNTRIES is a comma-separated list of ISO 3166-1 alpha-2 country codes - default
# covers the jurisdictions under comprehensive OFAC sanctions programs.
# GEOBLOCK_UA_REGIONS additionally blocks specific Ukrainian oblasts (comma-separated,
# case-insensitive substring match against the geolocation provider's region name) without
# blocking the rest of Ukraine. Leave empty to disable region-level blocking while keeping
# country-level blocking active.
GEOBLOCK_ENABLED=true
GEOBLOCK_COUNTRIES=RU,BY,CU,IR,KP,SY
GEOBLOCK_UA_REGIONS=Crimea,Donetsk,Luhansk,Zaporizhzhia,Kherson
# Turn this on TEMPORARILY to see exactly what IP/country the middleware resolves for each
# request in your server's logs - see app/config.py's geoblock_debug_log docstring. Turn it
# back off once you've diagnosed whatever you're chasing.
GEOBLOCK_DEBUG_LOG=false

# Public developer API (POST /api/v1/chat/completions) pricing - see app/config.py's
# public_api_* settings for the full reasoning. Prices are in whole US cents per ONE MILLION
# tokens. Defaults are roughly a 3x markup over this platform's own raw Groq cost.
PUBLIC_API_INPUT_PRICE_CENTS_PER_MILLION=50
PUBLIC_API_OUTPUT_PRICE_CENTS_PER_MILLION=200
PUBLIC_API_MIN_CHARGE_CENTS=1
PUBLIC_API_DEFAULT_MODEL=openai/gpt-oss-120b
PUBLIC_API_MAX_TOKENS_CAP=4096
